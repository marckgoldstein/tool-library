# Copy to .env for local development. Never commit real secrets.
DATABASE_URL="postgresql://toollib:toollib@localhost:5432/toollib_dev"
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
# "dev" keeps email local (see /dev/mailbox). "resend" arrives with hosting (T1).
EMAIL_TRANSPORT="dev"
# "local" stores photos under .data/uploads. "r2" arrives with hosting (T1).
STORAGE_DRIVER="local"
